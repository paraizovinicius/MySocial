DB_USERNAME = 
DB_PASSWORD =

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=enter_your_bucket_name
# base URL images are served from: either the bucket's public r2.dev URL
# (enable "Public access" on the bucket in the Cloudflare dashboard) or a custom domain.
# no trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev